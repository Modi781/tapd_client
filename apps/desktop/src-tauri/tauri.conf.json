{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TAPD Client",
  "version": "0.1.0",
  "identifier": "com.tapdclient.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TAPD Client",
        "width": 1180,
        "height": 780,
        "minWidth": 960,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "category": "DeveloperTool",
    "shortDescription": "TAPD enhanced client",
    "longDescription": "A TAPD desktop client with a rebuilt bug view, MCP server and AI agent integration.",
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
